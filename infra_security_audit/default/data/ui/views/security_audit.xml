<dashboard>
  <label>Security Audit</label>
  <description>Security posture of the Splunk deployment: authentication activity and failed logins, the user/role inventory, privileged configuration changes, TLS/SSL configuration, world-writable knowledge objects, and access to sensitive REST endpoints. All searches run against index=_audit, index=_internal, and Splunk's own authentication/authorization/server REST endpoints - no add-on required. Note: login events reflect Splunk's local authentication logging; if the deployment uses SSO/SAML in front of Splunk, failed-login visibility here may be partial.</description>

  <row>
    <panel>
      <title>Failed Logins (24h)</title>
      <single>
        <search>
          <query>`audit_login_events` info=failed earliest=-24h | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
          <refresh>300</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[20,100]</option>
        <option name="rangeColors">["#65A637","#FFC300","#B0413E"]</option>
        <option name="height">100</option>
      </single>
    </panel>
    <panel>
      <title>Successful Logins (24h)</title>
      <single>
        <search>
          <query>`audit_login_events` info=granted earliest=-24h | stats count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
          <refresh>300</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
      </single>
    </panel>
    <panel>
      <title>Locked-Out Accounts</title>
      <single>
        <search>
          <query>| rest /services/authentication/users splunk_server=local | search "locked-out"=1 | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[1]</option>
        <option name="rangeColors">["#65A637","#B0413E"]</option>
        <option name="height">100</option>
      </single>
    </panel>
    <panel>
      <title>Users with Admin Role</title>
      <single>
        <search>
          <query>| rest /services/authentication/users splunk_server=local | search roles=admin | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Login Activity - Last 7 Days</title>
      <chart>
        <search>
          <query>`audit_login_events` | timechart span=6h count by info</query>
          <earliest>-7d</earliest>
          <latest>now</latest>
          <refresh>900</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.axisTitleY.text">Login attempts</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Top Users - Failed Logins (7d)</title>
      <table>
        <search>
          <query>`audit_login_events` info=failed | fillnull value="(unknown)" user | stats count by user | sort -count | head 15 | rename user as User, count as "Failed Attempts"</query>
          <earliest>-7d</earliest>
          <latest>now</latest>
          <refresh>900</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>User Inventory</title>
      <table>
        <search>
          <query>| rest /services/authentication/users splunk_server=local | table title, roles, type, email, realname, "locked-out" | rename title as User, type as "Auth Type", "locked-out" as "Locked Out"</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Role Inventory &amp; Index Access</title>
      <table>
        <search>
          <query>| rest /services/authorization/roles splunk_server=local | eval CapabilityCount=mvcount(capabilities) | table title, CapabilityCount, srchIndexesAllowed, srchIndexesDefault, imported_roles | rename title as Role, CapabilityCount as "# Capabilities", srchIndexesAllowed as "Indexes Allowed", srchIndexesDefault as "Default Indexes", imported_roles as "Inherits From"</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Privileged Configuration Changes - Last 7 Days</title>
      <table>
        <search>
          <query>index=_audit (action=edit_user OR action=edit_roles OR action=edit_authentication OR action=change_authentication) earliest=-7d | table _time, user, action, info | sort -_time | head 25 | rename user as User, action as Action, info as Result</query>
          <earliest>-7d</earliest>
          <latest>now</latest>
          <refresh>900</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Splunk Web SSL</title>
      <single>
        <search>
          <query>| rest /services/server/settings splunk_server=local | eval WebSSL=if(match('enableSplunkWebSSL',"(?i)^(1|true)$"),"Enabled","DISABLED") | table WebSSL</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="height">100</option>
      </single>
    </panel>
    <panel>
      <title>Management Port (8089) SSL</title>
      <single>
        <search>
          <query>| rest /services/configs/conf-server splunk_server=local | search title=sslConfig | eval MgmtSSL=if(match('enableSplunkdSSL',"(?i)^(0|false)$"),"DISABLED","Enabled") | table MgmtSSL</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="height">100</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Globally Shared Saved Searches Writable by Everyone</title>
      <table>
        <search>
          <query>| rest /services/saved/searches splunk_server=local | search "eai:acl.sharing"="global" "eai:acl.perms.write"="*" | table title, "eai:acl.app", "eai:acl.owner" | rename title as "Saved Search", "eai:acl.app" as App, "eai:acl.owner" as Owner</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Sensitive REST API Access - Last 24h</title>
      <table>
        <search>
          <query>index=_internal sourcetype=splunkd_access earliest=-24h (uri="*authentication/users*" OR uri="*authorization/roles*" OR uri="*data/indexes*" OR uri="*server/settings*") | stats count by user, uri, status | sort -count | head 20 | rename user as User, uri as Endpoint, status as "HTTP Status", count as Calls</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
          <refresh>900</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
</dashboard>
