<dashboard version="1.1">
  <label>AD Accounts Overview</label>
  <description>Account-hygiene view of Active Directory built on the lookups of the Microsoft Windows Active Directory Objects app (see README for the lookup names/macros to adjust): enabled vs disabled, password-never-expires, locked, expired, stale, privileged and risky configurations. Figures reflect the last refresh of the lookups, not live LDAP.</description>

  <row>
    <panel>
      <title>User accounts</title>
      <single>
        <search>
          <query>| `adx_users` | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
      </single>
    </panel>
    <panel>
      <title>Enabled</title>
      <single>
        <search>
          <query>| `adx_users` | where is_disabled=0 | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
      </single>
    </panel>
    <panel>
      <title>Disabled</title>
      <single>
        <search>
          <query>| `adx_users` | where is_disabled=1 | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
      </single>
    </panel>
    <panel>
      <title>Password never expires (enabled)</title>
      <single>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND pwd_never_expires=1 | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[1,50]</option>
        <option name="rangeColors">["#65A637","#FFC300","#B0413E"]</option>
      </single>
    </panel>
    <panel>
      <title>Locked out</title>
      <single>
        <search>
          <query>| `adx_users` | where is_locked=1 | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[1]</option>
        <option name="rangeColors">["#65A637","#B0413E"]</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Password not required (enabled)</title>
      <single>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND pwd_not_required=1 | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[1]</option>
        <option name="rangeColors">["#65A637","#B0413E"]</option>
      </single>
    </panel>
    <panel>
      <title>Expired but still enabled</title>
      <single>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND is_expired=1 | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[1]</option>
        <option name="rangeColors">["#65A637","#B0413E"]</option>
      </single>
    </panel>
    <panel>
      <title>Stale enabled accounts</title>
      <single>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND days_since_logon&gt;`adx_stale_days` | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[1,50]</option>
        <option name="rangeColors">["#65A637","#FFC300","#B0413E"]</option>
        <option name="underLabel">no logon for more than adx_stale_days days</option>
      </single>
    </panel>
    <panel>
      <title>Privileged accounts (enabled)</title>
      <single>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND is_privileged=1 | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
      </single>
    </panel>
    <panel>
      <title>krbtgt password age (days)</title>
      <single>
        <search>
          <query>| `adx_users` | where sam="krbtgt" | stats max(pwd_age_days) as age</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[180]</option>
        <option name="rangeColors">["#65A637","#B0413E"]</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Enabled vs disabled</title>
      <chart>
        <search>
          <query>| `adx_users` | eval state=if(is_disabled=1,"Disabled","Enabled") | stats count by state</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">none</option>
        <option name="height">260</option>
      </chart>
    </panel>
    <panel>
      <title>Password posture of enabled accounts</title>
      <chart>
        <search>
          <query>| `adx_users` | where is_disabled=0 | eval posture=case(pwd_never_expires=1,"Never expires", pwd_age_days&gt;`adx_max_pwd_age_days`,"Older than policy age", isnull(pwd_age_days),"Unknown", true(),"Within policy age") | stats count by posture</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">none</option>
        <option name="height">260</option>
      </chart>
    </panel>
    <panel>
      <title>Password age of enabled accounts</title>
      <chart>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND isnotnull(pwd_age_days) | eval b=case(pwd_age_days&lt;=30,"1) 0-30 d", pwd_age_days&lt;=90,"2) 31-90 d", pwd_age_days&lt;=180,"3) 91-180 d", pwd_age_days&lt;=365,"4) 181-365 d", true(),"5) &gt; 1 year") | stats count by b | sort b</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.drilldown">none</option>
        <option name="height">260</option>
      </chart>
    </panel>
    <panel>
      <title>Last logon of enabled accounts</title>
      <chart>
        <search>
          <query>| `adx_users` | where is_disabled=0 | eval b=case(isnull(days_since_logon),"6) Never / unknown", days_since_logon&lt;=7,"1) &lt;= 7 d", days_since_logon&lt;=30,"2) 8-30 d", days_since_logon&lt;=90,"3) 31-90 d", days_since_logon&lt;=180,"4) 91-180 d", true(),"5) &gt; 180 d") | stats count by b | sort b</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.drilldown">none</option>
        <option name="height">260</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Password never expires - by OU (top 15, enabled)</title>
      <chart>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND pwd_never_expires=1 | stats count by ou | sort - count | head 15</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.drilldown">none</option>
        <option name="height">380</option>
      </chart>
    </panel>
    <panel>
      <title>Password never expires - enabled accounts</title>
      <table>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND pwd_never_expires=1 | eval privileged=if(is_privileged=1,"YES","no"), last_logon=strftime(last_logon,"%Y-%m-%d") | sort - is_privileged, - pwd_age_days | table sam display_name ou pwd_age_days last_logon privileged</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">12</option>
        <option name="wrap">true</option>
        <option name="rowNumbers">false</option>
        <format type="color" field="privileged">
          <colorPalette type="map">{"YES":#F8BE34}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Risky account configurations (enabled)</title>
      <table>
        <search>
          <query>| `adx_users` | where is_disabled=0 | eval risk=mvappend(if(pwd_not_required=1,"PASSWD_NOTREQD",null()), if(no_preauth=1,"DONT_REQ_PREAUTH (AS-REP roastable)",null()), if(trusted_for_delegation=1,"Unconstrained delegation",null()), if(pwd_never_expires=1 AND is_privileged=1,"Privileged + password never expires",null()), if(is_privileged=1 AND days_since_logon&gt;`adx_stale_days`,"Privileged + stale",null())) | where isnotnull(risk) | table sam display_name risk ou pwd_age_days</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">12</option>
        <option name="wrap">true</option>
        <option name="rowNumbers">false</option>
      </table>
    </panel>
    <panel>
      <title>Accounts expiring in the next 30 days</title>
      <table>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND isnotnull(acct_expires) AND acct_expires&gt;now() AND acct_expires&lt;now()+30*86400 | eval days_left=round((acct_expires-now())/86400,0), expires=strftime(acct_expires,"%Y-%m-%d") | sort days_left | table sam display_name expires days_left ou</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">12</option>
        <option name="wrap">true</option>
        <option name="rowNumbers">false</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Enabled accounts past their expiry date</title>
      <table>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND is_expired=1 | eval expired_on=strftime(acct_expires,"%Y-%m-%d") | table sam display_name expired_on ou</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">8</option>
        <option name="wrap">true</option>
        <option name="rowNumbers">false</option>
      </table>
    </panel>
    <panel>
      <title>Disabled accounts that still belong to a privileged group</title>
      <table>
        <search>
          <query>| `adx_users` | where is_disabled=1 AND is_privileged=1 | table sam display_name ou memberOf</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">8</option>
        <option name="wrap">true</option>
        <option name="rowNumbers">false</option>
      </table>
    </panel>
    <panel>
      <title>Stale enabled accounts (oldest logon first)</title>
      <table>
        <search>
          <query>| `adx_users` | where is_disabled=0 AND days_since_logon&gt;`adx_stale_days` | eval last_logon=strftime(last_logon,"%Y-%m-%d") | sort - days_since_logon | table sam display_name last_logon days_since_logon ou</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">8</option>
        <option name="wrap">true</option>
        <option name="rowNumbers">false</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Daily trend (needs the "AD KPI Snapshot" saved search enabled)</title>
      <html><p>History is built by the disabled-by-default saved search "AD - KPI Snapshot to Summary Index". Enable it to see how these figures evolve.</p></html>
      <chart>
        <search>
          <query>index=summary sourcetype=adx_kpi_snapshot | timechart span=1d max(never_expire_enabled) as "Never expires (enabled)", max(disabled) as "Disabled", max(stale_enabled) as "Stale enabled", max(locked) as "Locked"</query>
          <earliest>-90d@d</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.drilldown">none</option>
        <option name="height">300</option>
      </chart>
    </panel>
    <panel>
      <title>Computers by operating system (top 10)</title>
      <chart>
        <search>
          <query>| `adx_computers` | where is_disabled=0 | stats count by os | sort - count | head 10</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.drilldown">none</option>
        <option name="height">300</option>
      </chart>
    </panel>
    <panel>
      <title>Stale enabled computers</title>
      <single>
        <search>
          <query>| `adx_computers` | where is_disabled=0 AND days_since_logon&gt;`adx_stale_days` | stats count</query>
          <earliest>-5m</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="height">100</option>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[1,50]</option>
        <option name="rangeColors">["#65A637","#FFC300","#B0413E"]</option>
      </single>
    </panel>
  </row>
</dashboard>
