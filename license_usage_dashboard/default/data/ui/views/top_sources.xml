<form>
  <label>Top Sources</label>
  <description>Which indexes, sourcetypes, hosts or sources consume the most license, over a selectable time range, with a Pareto breakdown (share of total and cumulative share) to spot the few contributors driving most of the volume.</description>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time_tok2">
      <label>Time Range</label>
      <default>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="breakdown_field">
      <label>Break down by</label>
      <choice value="idx">Index</choice>
      <choice value="st">Sourcetype</choice>
      <choice value="h">Host</choice>
      <choice value="s">Source</choice>
      <default>idx</default>
      <initialValue>idx</initialValue>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Top 15 by $breakdown_field$</title>
      <chart>
        <search>
          <query>`license_usage_base` | `license_usage_gb` | stats sum(GB) as GB by $breakdown_field$ | sort -GB | head 15</query>
          <earliest>$time_tok2.earliest$</earliest>
          <latest>$time_tok2.latest$</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.axisTitleY.text">GB indexed</option>
        <option name="charting.legend.placement">none</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Share of Total - Top 10 by $breakdown_field$</title>
      <chart>
        <search>
          <query>`license_usage_base` | `license_usage_gb` | stats sum(GB) as GB by $breakdown_field$ | sort -GB | head 10</query>
          <earliest>$time_tok2.earliest$</earliest>
          <latest>$time_tok2.latest$</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="charting.chart">pie</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Pareto Detail by $breakdown_field$</title>
      <table>
        <search>
          <query>`license_usage_base` | `license_usage_gb` | stats sum(GB) as GB by $breakdown_field$ | sort -GB | eventstats sum(GB) as TotalGB | eval GB=round(GB,3), PctOfTotal=round((GB/TotalGB)*100,2) | streamstats sum(PctOfTotal) as CumulativePct | eval CumulativePct=round(CumulativePct,1) | table $breakdown_field$ GB PctOfTotal CumulativePct</query>
          <earliest>$time_tok2.earliest$</earliest>
          <latest>$time_tok2.latest$</latest>
          <refresh>3600</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
</form>
